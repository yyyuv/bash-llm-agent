// doit v2 — safety / confirm (Phase 2)
// Same single-command turn as v1, plus a SAFETY_INSTRUCTIONS block in the
// system prompt. The regex guard + y/N confirm are CONTROLLER logic (safety.py
// / _handle_run_command) — they send nothing to the model, so they are NOT in
// this spec. The only safety-related thing that reaches the context is the
// instructions block; as in v1 the command result is not fed back.

DoitAgentSafety[@T]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS                    // destructive -> y/N gate; sudo/interactive blocked
    AVAILABLE_TOOLS(run_command, answer)   // via API tools=; run_command(command, is_destructive, explanation) — is_destructive + explanation ARE safety layer 1
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }
  U: env.user_request[@T]
}
