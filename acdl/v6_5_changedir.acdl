// doit v6.5 — change_dir (the cd-trap fix, inserted before Phase 7)
// Builds on v6. New tool change_dir(path), a within-turn step. The cd trap: a
// subprocess can't change its parent shell's cwd, so change_dir writes the
// target to ~/.doit/cd_target_$DOIT_SESSION and the doit() shell wrapper reads
// it after exit and performs the real cd — CONTROLLER / shell logic, not
// context, so it is not shown. The model only sees back one result: "will cd
// after exit (qualify a same-turn command)" or "no such directory".

DoitAgentChangeDir[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS
    MEMORY_INSTRUCTIONS
    AVAILABLE_TOOLS(run_command, ask_user, answer, remember, forget, change_dir)
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  U: {
    MEMORY_HEADER
    ForEach(m: sys.memories) { sys.memory_line[m] }
  }

  // replay the last K turns of THIS session as chat
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  // current turn: change_dir is a within-turn step, so it can compose with a
  // run_command in the same turn (its result carries the "not yet — qualify a
  // same-turn command" note; the path validation + cd_target write are controller work)
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]                            // ... | change_dir
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)  // change_dir -> "will cd after exit" | "no such directory"
    }
  }
}
