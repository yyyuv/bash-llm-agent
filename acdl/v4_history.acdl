// doit v4 — multi-turn history (Phase 4)
// Same single decision + safety as v2. New: replay THIS session's last K turns
// as chat BEFORE the current request, so a follow-up ("now sort them by date")
// resolves against the previous turn. Older turns use the COLD truncation
// budget, the live turn HOT (tools.truncate_for_context) — a controller detail,
// shown here only as truncate(...). History is an action history -> sys.history.

DoitAgentHistory[@T]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    AVAILABLE_TOOLS(run_command, answer)             // native: passed via API tools=
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  // replay the last K turns of THIS session as chat (oldest first)
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      }
      Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  U: env.user_request[@T]
  // still single-command (as v1/v2): the current command's result is not fed
  // back into context; only the REPLAYED past turns above are re-sent.
}
