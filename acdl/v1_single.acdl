// doit v1 — single-command agent (Phase 1)
// The context we assemble and send: system + env + request. In single-command
// mode the decision and its result are output, never fed back, so neither
// appears. Native tools travel out-of-band via the API tools= parameter.

DoitAgentSingleCommand[@T]: {
  S: {
    AGENT_INSTRUCTIONS
    AVAILABLE_TOOLS(run_command, answer)   // via API tools=
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }
  U: env.user_request[@T]
}
