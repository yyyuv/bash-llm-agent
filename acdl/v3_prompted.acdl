// doit v3 — the PROMPTED adapter (Phase 3, model flexibility)
// Same agent / tools / safety as v2 — only the plumbing to the LPU differs, for
// local models WITHOUT native tool-calling. Two changes are visible here:
//   1. the tools move INTO the prompt as text (AVAILABLE_TOOLS_TEXT +
//      JSON_PROTOCOL_INSTRUCTIONS), instead of the native out-of-band tools=.
//   2. the decision arrives as raw model text we parse. The one-shot retry IS
//      context (unlike the safety gate) because RETRY_CORRECTION is itself a
//      real U: message sent back to the model.
// This resp.raw_reply -> sys.tool_call parse is the deliberate diff vs v2.

DoitAgentPrompted[@T]: {
  // this agent assumes no inherent tool-use capability
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    AVAILABLE_TOOLS_TEXT                             // tool names/args/descriptions rendered INTO the prompt
    JSON_PROTOCOL_INSTRUCTIONS                       // "reply with ONLY the tool + args as bare JSON"
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }
  U: env.user_request[@T]

  // the model returns raw text; the controller extracts + validates JSON into
  // sys.tool_call and, on a parse failure, feeds RETRY_CORRECTION back as a U:
  // message and retries once (llm._extract_json_object / prompted_retry.txt).
  A: resp.raw_reply[@T]                               // may wrap the JSON in prose / code fences
  U: RETRY_CORRECTION                                 // only on a parse failure; one retry, then re-parsed
  // still single-command: the parsed command's result is not fed back (as v1/v2)
}
