// doit v8 — multi-tasking / cross-session awareness (Phase 8, Decision 10c)
// Builds on v7. Two additions: an always-injected OTHER_SESSIONS summary block
// (one heuristic line per other recent session, computed in Python via
// list_other_sessions), and a new tool read_session(session_id) to fetch one in
// full on demand. Block ORDER is load-bearing: the other-session summaries sit
// BEFORE this session's own replayed history, so an implicit "them" binds to
// THIS session (the closest context), not to another window.

DoitAgentMultitask[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS
    MEMORY_INSTRUCTIONS
    CHANGE_DIR_INSTRUCTIONS
    CROSS_SESSION_INSTRUCTIONS                       // local-by-default vs explicit cross-reference
    AVAILABLE_TOOLS(run_command, ask_user, answer, remember, forget, change_dir, read_session)
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  U: {
    MEMORY_HEADER
    ForEach(m: sys.memories) { sys.memory_line[m] }
  }

  // OTHER sessions — always injected, one heuristic line each, BEFORE own history
  U: {
    OTHER_SESSIONS_HEADER
    ForEach(s: sys.other_sessions) { sys.session_summary[s] }  // "session <id> (<age>, in <cwd>): <recent requests>"
  }

  // THIS session's own replayed history (AFTER other-sessions => implicit "them" binds here)
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  U: {
    USER_SHELL_HISTORY_HEADER
    ForEach(h: env.recent_user_commands[@T]) { env.shell_cmd[h] }
  }

  // current turn: adds a read_session step (within-turn) to the same loop
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]                            // ... | read_session
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)  // read_session -> target's last K turns | "unavailable"
    }
  }
}
