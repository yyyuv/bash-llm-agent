// doit v6 — persistent memory (Phase 6)
// Builds on v5. New tools remember(fact)/forget(id) and a new context block:
// sys.memories — ALL stored facts, injected every turn, each with its visible
// [id] (load-bearing: it's how the model names which fact to forget). Not
// session-keyed — a shared store, so it sits with the ambient S/U setup, above
// the per-session history loop. A memory op is a within-turn step; its ack is
// just that step's tool_response.

DoitAgentMemory[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS
    MEMORY_INSTRUCTIONS                  // store durable facts only
    AVAILABLE_TOOLS(run_command, ask_user, answer, remember, forget)
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }
  // all stored facts, every turn, each with its [id]
  U: {
    MEMORY_HEADER
    ForEach(m: sys.memories) { sys.memory_line[m] }  // "- [<id>] <text>"
  }
  // replay the last K turns of THIS session as chat
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }
  // current turn: within-turn loop (remember/forget are within-turn steps too;
  // the safety gate on run_command is controller logic, not context)
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]                            // run_command | ask_user | answer | remember | forget
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)  // output | reply | memory ack
    }
  }
}
