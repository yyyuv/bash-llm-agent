// doit v7 — user shell-history awareness (Phase 7)
// Builds on v6.5. No new tool — a new context SOURCE: USER_SHELL_HISTORY, the
// commands the user typed directly in this terminal (a shell hook logs them to
// shell_hist; doit's own invocations are filtered out, block skipped when
// empty). Spliced after the replayed history, before the current request.

DoitAgentUserAware[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS
    MEMORY_INSTRUCTIONS
    CHANGE_DIR_INSTRUCTIONS
    AVAILABLE_TOOLS(run_command, ask_user, answer, remember, forget, change_dir)
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  U: {
    MEMORY_HEADER
    ForEach(m: sys.memories) { sys.memory_line[m] }
  }

  // replay the last K turns of THIS session as chat
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  // NEW: what the user typed directly in this terminal (not via doit)
  U: {
    USER_SHELL_HISTORY_HEADER
    ForEach(h: env.recent_user_commands[@T]) { env.shell_cmd[h] }  // "[in <cwd>] <cmd>"
  }

  // current turn: same within-turn loop and branches as v6.5 (incl change_dir)
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)
    }
  }
}
