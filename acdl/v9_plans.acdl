// doit v9 — multi-step command plans + self-correcting retry (Phase 9, D11)
// Builds on v8. New tool plan(steps[]) — offered ONLY when config.enable_plans
// is true (a real context difference: a gated-off model is never told the tool
// exists). plan announces plain-English steps and is a within-turn step; the
// model then issues one run_command at a time, reading each real result before
// the next. The per-turn command_budget raise and the always-on rc!=0 retry are
// CONTROLLER state (run_turn locals) — they send NO message to the model, so
// they are not in this spec; from context, retry is just another run_command
// result followed by another run_command.

DoitAgentPlans[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS                               // + plan usage + recovery-stop rule
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS
    MEMORY_INSTRUCTIONS
    CHANGE_DIR_INSTRUCTIONS
    CROSS_SESSION_INSTRUCTIONS
    PLAN_INSTRUCTIONS
    AVAILABLE_TOOLS(run_command, ask_user, answer, remember, forget, change_dir, read_session, plan)
                                                     // plan present ONLY when config.enable_plans == true
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  U: {
    MEMORY_HEADER
    ForEach(m: sys.memories) { sys.memory_line[m] }
  }

  U: {
    OTHER_SESSIONS_HEADER
    ForEach(s: sys.other_sessions) { sys.session_summary[s] }
  }

  // replay the last K turns of THIS session as chat
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].tool == plan {
        A: sys.history[@t].steps[@i].announced_steps  // gist only, not replayed as binding
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  U: {
    USER_SHELL_HISTORY_HEADER
    ForEach(h: env.recent_user_commands[@T]) { env.shell_cmd[h] }
  }

  // current turn: same within-turn loop, now with a plan step. plan() raises the
  // controller's per-turn command_budget and rc!=0 grants one retry — both are
  // run_turn locals, NOT context, so the loop SHAPE is unchanged.
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]                            // ... | plan | run_command
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)  // plan -> announced steps; run_command -> rc/stdout/stderr
    }
  }
}
