// doit v5 — clarifications + richer interactions (Phase 5)
// Builds on v4. New: ask_user(question, options?) and a WITHIN-TURN loop —
// ask_user does NOT end the turn; the reply is fed back and the model is
// re-called, so @T.I now ranges over several steps in one turn. THIS is where a
// tool result first re-enters context (v1-v4 never fed one back). The
// clarification cap (MAX_CLARIFICATIONS) and empty-input default are controller
// logic; the model just sees back the one reply message as the tool_response.

DoitAgentClarify[@T, I]: {
  S: {
    AGENT_INSTRUCTIONS
    SAFETY_INSTRUCTIONS
    CLARIFICATION_INSTRUCTIONS                       // ask only when a wrong guess is destructive / interpretations differ
    AVAILABLE_TOOLS(run_command, ask_user, answer)   // native: passed via API tools=
  }
  U: {
    ENV_INFO(env.cwd[@T], env.datetime[@T], env.shell[@T], env.os[@T])
  }

  // replay the last K turns of THIS session as chat
  ForEach(@t: range(1, @T-1)) {
    U: sys.history[@t].request
    ForEach(@i: sys.history[@t].steps) {
      If sys.history[@t].steps[@i].tool == ask_user {
        A: sys.history[@t].steps[@i].question
        U: sys.history[@t].steps[@i].reply
      } ElseIf sys.history[@t].steps[@i].ran {
        A: sys.history[@t].steps[@i].command
        U: truncate(sys.history[@t].steps[@i].output)
      } Else {
        A: sys.history[@t].steps[@i].blocked
      }
    }
    If sys.history[@t].final_answer {
      A: sys.history[@t].final_answer
    }
  }

  // current turn: a within-turn loop; every non-answer step feeds a result back
  U: env.user_request[@T]
  ForEach(@i: range(1, I)) {
    A: sys.tool_call[@T.i]                            // run_command | ask_user | answer
    If sys.tool_call[@T.i] != answer {
      T: truncate(sys.tool_call[@T.i].tool_response)  // command output | the user's reply
    }
  }
}
